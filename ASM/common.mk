(정의 뛰기 0육ㅁㄴ)

; 구분이 필요함
; 숫자를 레지스터에 넣을 때
; 레지스터끼리 복사할 때
; 세그먼트 레지스터를 다룰 때
; 메모리에 값을 쓸 때

;; Opcode 정의
(정의 _이동_셈 0육B8)
(정의 _이동_횟수 0육B9)
(정의 _이동_자료 0육BA)
(정의 _이동_기준 0육BB)
(정의 _이동_출처 0육BE)

;; --- 레지스터 간 이동 명령어 ---
;; --- 일반 레지스터 번호 (R/M) ---
(정의 _셈 0) (정의 _횟수 1) (정의 _자료 2) (정의 _기준 3)
(정의 _쌓음 4) (정의 _16톨-바닥 5) (정의 _출처 6) (정의 _도착 7)

;; --- 세그먼트 레지스터 번호 (Reg) ---
(정의 _여분판 0) ;; Extra Segment
(정의 _글판 1) ;; Code Segment
(정의 _쌓음판 2) ;; Stack Segment
(정의 _자료판 3) ;; Data Segment

;; ModR/M 바이트 계산기
;; 입력: 목적지(reg), 출발지(rm)
;; 반환: 계산된 1바이트 정수
(정의 (이동_레지스터 reg rm)
  (+ 
      0육C0               ;; Mod(11) << 6 = 0xC0 (기본값)
      (+ (비트이동 reg 3) ;; 목적지(Reg) << 3
        rm)              ;; 출발지(R/M)
  )
)

;; (2바이트 값)의 결과가 리스트이므로, 그 앞에 Opcode를 붙입니다.
;; 예: (MOV_AX 0) -> (짝 0육B8 (0육00 0육00)) -> (0육B8 0육00 0육00)
(정의 (이동_셈 값) 
  (짝 _이동_셈 (2바이트 값)))

(정의 (이동_횟수 값) 
  (짝 _이동_횟수 (2바이트 값)))

(정의 (이동_자료 값) 
  (짝 _이동_자료 (2바이트 값)))

(정의 (이동_기준 값) 
  (짝 _이동_기준 (2바이트 값)))

(정의 (이동_출처 값) 
  (짝 _이동_출처 (2바이트 값)))

; 한 글자를 받아서 아스키 코드(16진수)로 바꿔주는 함수
(정의 (문을육 글자)
  (조건
    ; --- 알파벳 소문자 (0육61 ~ 0육7ㄱ) ---
    ((같다? 글자 'a) 0육61) ((같다? 글자 'b) 0육62) ((같다? 글자 'c) 0육63) ((같다? 글자 'd) 0육64) 
    ((같다? 글자 'e) 0육65) ((같다? 글자 'f) 0육66) ((같다? 글자 'g) 0육67) ((같다? 글자 'h) 0육68) 
    ((같다? 글자 'i) 0육69) ((같다? 글자 'j) 0육6A) ((같다? 글자 'k) 0육6B) ((같다? 글자 'l) 0육6C) 
    ((같다? 글자 'm) 0육6D) ((같다? 글자 'n) 0육6E) ((같다? 글자 'o) 0육6F) ((같다? 글자 'p) 0육70) 
    ((같다? 글자 'q) 0육71) ((같다? 글자 'r) 0육72) ((같다? 글자 's) 0육73) ((같다? 글자 't) 0육74) 
    ((같다? 글자 'u) 0육75) ((같다? 글자 'v) 0육76) ((같다? 글자 'w) 0육77) ((같다? 글자 'x) 0육78) 
    ((같다? 글자 'y) 0육79) ((같다? 글자 'z) 0육7A)

    ; --- 알파벳 대문자 (0육41 ~ 0육5ㄱ) ---
    ((같다? 글자 'A) 0육41) ((같다? 글자 'B) 0육42) ((같다? 글자 'C) 0육43) ((같다? 글자 'D) 0육44)
    ((같다? 글자 'E) 0육45) ((같다? 글자 'F) 0육46) ((같다? 글자 'G) 0육47) ((같다? 글자 'H) 0육48)
    ((같다? 글자 'I) 0육49) ((같다? 글자 'J) 0육4A) ((같다? 글자 'K) 0육4B) ((같다? 글자 'L) 0육4C)
    ((같다? 글자 'M) 0육4D) ((같다? 글자 'N) 0육4E) ((같다? 글자 'O) 0육4F) ((같다? 글자 'P) 0육50)
    ((같다? 글자 'Q) 0육51) ((같다? 글자 'R) 0육52) ((같다? 글자 'S) 0육53) ((같다? 글자 'T) 0육54)
    ((같다? 글자 'U) 0육55) ((같다? 글자 'V) 0육56) ((같다? 글자 'W) 0육57) ((같다? 글자 'X) 0육58)
    ((같다? 글자 'Y) 0육59) ((같다? 글자 'Z) 0육5A)

    ; --- 숫자 (0x30 ~ 0x39) ---
    ((같다? 글자 '0) 0육30) ((같다? 글자 '1) 0육31) ((같다? 글자 '2) 0육32) ((같다? 글자 '3) 0육33)
    ((같다? 글자 '4) 0육34) ((같다? 글자 '5) 0육35) ((같다? 글자 '6) 0육36) ((같다? 글자 '7) 0육37)
    ((같다? 글자 '8) 0육38) ((같다? 글자 '9) 0육39)

    ; --- 특수문자 ---
    ((같다? 글자 '공백) 0육20)  ; 공백(Space)
    ((같다? 글자 '-) 0육2D)  ; 하이픈(-)
    ((같다? 글자 '점) 0육2E)  ; 점(.)
    
    ; 모르는 글자는 0으로 처리 (안전을 위해)
    (#참 0)
  )
)

(정의 (2바이트 값)
  (리스트
    (비트곱 값 0육FF)               ; 하위 바이트
    (비트곱 (비트이동 값 -8) 0육FF)   ; 상위 바이트
  )
)

(정의 (4바이트 값)
  (리스트
    (비트곱 값 0육FF)                   ; 가장 하위 바이트
    (비트곱 (비트이동 값 -8) 0육FF)       ; 두 번째 바이트
    (비트곱 (비트이동 값 -16) 0육FF)      ; 세 번째 바이트
    (비트곱 (비트이동 값 -24) 0육FF)      ; 가장 상위 바이트
  )
)

(정의 (채워넣기 값 횟수)
  (만약 (< 횟수 1)
    공
    (짝 값 (채워넣기 값 (- 횟수 1)))
  )
)

(정의 (길이 리스트)
  (만약 (공? 리스트)
    0
    (+ 1 (길이 (꼬 리스트)))
  )
)