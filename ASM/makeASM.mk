;; x86_64 아키텍처를 기준으로

;; 1. 누산기 (Accumulator) - ID: 0
(정의 '64톨-셈   (짝 0 64))
(정의 '32톨-셈   (짝 0 32))
(정의 '16톨-셈   (짝 0 16))
(정의 '윗8톨-셈  (짝 4 8))   ; AH
(정의 '밑8톨-셈  (짝 0 8))   ; AL

;; 2. 카운터 (Counter) - ID: 1
(정의 '64톨-횟수 (짝 1 64))
(정의 '32톨-횟수 (짝 1 32))
(정의 '16톨-횟수 (짝 1 16))
(정의 '윗8톨-횟수 (짝 5 8))   ; CH
(정의 '밑8톨-횟수 (짝 1 8))   ; CL

;; 3. 데이터 (Data) - ID: 2
(정의 '64톨-자료 (짝 2 64))
(정의 '32톨-자료 (짝 2 32))
(정의 '16톨-자료 (짝 2 16))
(정의 '윗8톨-자료 (짝 6 8))   ; DH
(정의 '밑8톨-자료 (짝 2 8))   ; DL

;; 4. 베이스 (Base) - ID: 3
(정의 '64톨-기준 (짝 3 64))
(정의 '32톨-기준 (짝 3 32))
(정의 '16톨-기준 (짝 3 16))
(정의 '윗8톨-기준 (짝 7 8))   ; BH
(정의 '밑8톨-기준 (짝 3 8))   ; BL

;; 5. 스택 포인터 (SP) - ID: 4
(정의 '64톨-쌓음 (짝 4 64))
(정의 '32톨-쌓음 (짝 4 32))
(정의 '16톨-쌓음 (짝 4 16))
(정의 '밑8톨-쌓음 (짝 4 8))   ; SPL (64비트 모드 전용)

;; 6. 베이스 포인터 (BP) - ID: 5
(정의 '64톨-바닥 (짝 5 64))
(정의 '32톨-바닥 (짝 5 32))
(정의 '16톨-바닥 (짝 5 16))
(정의 '밑8톨-바닥 (짝 5 8))   ; BPL (64비트 모드 전용)

;; 7. 소스 인덱스 (SI) - ID: 6
(정의 '64톨-출처 (짝 6 64))
(정의 '32톨-출처 (짝 6 32))
(정의 '16톨-출처 (짝 6 16))
(정의 '밑8톨-출처 (짝 6 8))   ; SIL

;; 8. 목적지 인덱스 (DI) - ID: 7
(정의 '64톨-도착 (짝 7 64))
(정의 '32톨-도착 (짝 7 32))
(정의 '16톨-도착 (짝 7 16))
(정의 '밑8톨-도착 (짝 7 8))   ; DIL

;; 9. 세그먼트 레지스터
(정의 '여분판  (짝 0 16))  ; ES
(정의 '글판    (짝 1 16))  ; CS
(정의 '쌓음판  (짝 2 16))  ; SS
(정의 '자료판  (짝 3 16))  ; DS
(정의 '여분판1 (짝 4 16))  ; FS
(정의 '여분판2 (짝 5 16))  ; GS

;; 10. 명령 포인터 (특수 취급)
(정의 '64톨-명령 (짝 -1 64)) ; RIP
(정의 '32톨-명령 (짝 -1 32)) ; EIP

(정의 (이동 목적지 원본)
  ;; 1. 비트 수 확인
  (변수 비트 (두번째값 목적지))  ; '큰셈'이면 64가 나옴
  
  ;; 2. 프리픽스 결정
  (만약 (= 비트 64)
      (바이트출력 0x48)      ; 64비트면 REX.W 프리픽스 출력!
      (아무것도안함))

  ;; 3. 기계어(Opcode) 만들기
  ;; MOV r64, r64의 기본 코드는 0x89
  (바이트출력 0x89)

  ;; 4. ModR/M 바이트 계산 (핵심!)
  ;; 목적지ID와 원본ID를 합쳐서 바이트를 만듦
  (변수 목적지ID (첫번째값 목적지)) ; 0
  (변수 원본ID   (첫번째값 원본))   ; 3
  
  ;; 비트 연산으로 0xC0 | (원본ID << 3) | 목적지ID
  (바이트출력 (ModRM생성 0xC0 원본ID 목적지ID))
)