	,@(채워넣기 8 0); RESB	8
	,@(2바이트 0육ㅂㅂㅂㅂ) ,@(2바이트 0육0000) ,@(2바이트 0육9200) ,@(2바이트 0육00ㄷㅂ); DW		0xffff, 0x0000, 0x9200, 0x00cf
	,@(2바이트 0육ㅂㅂㅂㅂ) ,@(2바이트 0육0000) ,@(2바이트 0육9ㄱ28) ,@(2바이트 0육0047); DW		0xffff, 0x0000, 0x9a28, 0x0047

	,@(2바이트 0) ; DW		0
))

(정의 지디티알0_원본 `(
	,(이름표 '지디티알0) ; GDTR0
	,@(2바이트 (- (* 8 3) 1)) ; DW		8*3-1
	,(4톨_이름표_주소 '지디티0) ; DD		GDT0
))

(정의 지디티알0 `(
	,@지디티알0_원본
	,@(채워넣기 
      (나머지 
        (- 16 (나머지 (크기구하기 `(,@헤더 ,@화면320 ,@입력상태 ,@파이프라인_플러시 ,@생략 ,@키보드기다려 ,@멤_복사 ,@지디티0 ,@지디티알0_원본)) 16)) 16) 0) ; ALIGNB 16
))

